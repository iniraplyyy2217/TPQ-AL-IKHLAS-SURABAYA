rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSantri(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.nis is string && data.nis.size() <= 64
        && data.nama is string && data.nama.size() <= 128
        && data.namaPanggilan is string && data.namaPanggilan.size() <= 64
        && data.kelasSD is string && data.kelasSD.size() <= 128
        && data.tingkatJilid is string && data.tingkatJilid.size() <= 128
        && data.namaWali is string && data.namaWali.size() <= 128
        && data.noHpWali is string && data.noHpWali.size() <= 32;
    }

    // Health / Connection Test
    match /test/{testId} {
      allow get: if true;
    }

    // Santri Private Data: strictly restricted to the authenticated santri
    // Each santri can only read, write, and manage their OWN data!
    match /santri/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && isValidSantri(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && isValidSantri(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
